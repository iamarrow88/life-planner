# Скопируй этот файл в .env и впиши свои значения. Файл .env в git не попадает.
# Без этих двух значений приложение работает в демо-режиме.
VITE_SUPABASE_URL=https://xxxx.supabase.co
VITE_SUPABASE_ANON_KEY=

# Необязательно: push-напоминания на сайте и Google Календарь
VITE_VAPID_PUBLIC_KEY=
VITE_GOOGLE_CLIENT_ID=
